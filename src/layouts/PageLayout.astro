<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title} · Insect-scale Autonomy</title>

  {description && <meta name="description" content={description} />}

  <!-- Open Graph / Link Preview -->
  <meta property="og:title" content="Insect-scale Autonomy Workshop" />
  <meta
    property="og:description"
    content="IROS 2026 Workshop on bio-inspired, resource-constrained autonomy across perception, design, control, and edge AI."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://insect-autonomy.github.io/" />
  <meta
    property="og:image"
    content="https://insect-autonomy.github.io/insect-autonomy-banner.jpg"
  />

  <!-- Optional but recommended -->
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="450" />
  <meta property="og:image:alt" content="Insect-scale Autonomy Workshop banner" />

  <!-- Twitter / social cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Insect-scale Autonomy Workshop" />
  <meta
    name="twitter:description"
    content="IROS 2026 Workshop on bio-inspired, resource-constrained autonomy."
  />
  <meta
    name="twitter:image"
    content="https://insect-autonomy.github.io/insect-autonomy-banner.jpg"
  />

  <link rel="icon" href={new URL("favicon.svg", Astro.site)} />
</head>
