---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EditPageLink from "../components/EditPageLink.astro";

const { title, description } = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const editableFiles = {
  "/": "src/content/pages/home.md",
  "/cfp": "src/content/pages/cfp.md",
  "/program": "src/content/pages/program.md",
  "/speakers": "src/content/pages/speakers.md",
  "/organizers": "src/content/pages/organizers.md",
};

const editableFile =
  editableFiles[normalizedPath as keyof typeof editableFiles];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title} · Insect-scale Autonomy</title>

    {description && <meta name="description" content={description} />}

    <meta property="og:title" content="Insect-scale Autonomy Workshop" />
    <meta
      property="og:description"
      content="IROS 2026 Workshop on bio-inspired, resource-constrained autonomy across perception, design, control, and edge AI."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://insect-autonomy.github.io/" />

    <meta
      property="og:image"
      content="https://insect-autonomy.github.io/insect-autonomy-banner.jpg"
    />
    <meta
      property="og:image:secure_url"
      content="https://insect-autonomy.github.io/insect-autonomy-banner.jpg"
    />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Insect-scale Autonomy Workshop" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Insect-scale Autonomy Workshop" />
    <meta
      name="twitter:description"
      content="IROS 2026 Workshop on bio-inspired, resource-constrained autonomy."
    />
    <meta
      name="twitter:image"
      content="https://insect-autonomy.github.io/insect-autonomy-banner.jpg"
    />

    <link rel="icon" href={new URL("BeeLogoFavicon3.png", Astro.site)} />
  </head>

  <script>
    const saved = localStorage.getItem("theme");
    const phoneViewport = window.matchMedia("(max-width: 700px)").matches;
    document.documentElement.dataset.theme = saved ?? (phoneViewport ? "dark" : "light");
  </script>

  <body>
    <Header />

    <main class="container">
      <slot />
    </main>

    {editableFile && <EditPageLink filePath={editableFile} />}

    <Footer />
  </body>
</html>
