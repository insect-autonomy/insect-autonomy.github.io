---
import PageLayout from "../layouts/PageLayout.astro";
import { getEntryBySlug } from "astro:content";

const entry = await getEntryBySlug("pages", "program");
if (!entry) throw new Error("Missing content: src/content/pages/program.md");
const { Content } = await entry.render();
const data = entry.data;
---

<PageLayout title={data.title} description={data.description}>

  <section class="section">
    <div class="program-actions">
      <a class="calendar-button" href="/workshop.ics" download="insect-scale-autonomy-2026.ics">Add to Calendar</a>
    </div>
    <div class="prose">
      <Content />
    </div>
  </section>
</PageLayout>

<style>
  .program-actions { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .calendar-button {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border: 1px solid var(--link);
    border-radius: 10px;
    background: var(--panel2);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .calendar-button:hover { background: color-mix(in srgb, var(--link) 15%, var(--panel2)); }
  .calendar-button:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; }
</style>
