---
import PageLayout from "../layouts/PageLayout.astro";
import { getEntryBySlug } from "astro:content";

const entry = await getEntryBySlug("pages", "home");
if (!entry) throw new Error("Missing content: src/content/pages/home.md");

const { Content } = await entry.render();
const data = entry.data;
---

<PageLayout title={data.title} description={data.description}>

  <aside class="deadline-notice" aria-label="Submission deadline extension">
    <strong>Submission deadline extended</strong>
    <span>Paper and poster submissions are now due September 1, 2026, at 11:59 PM AoE.</span>
    <a href="/cfp/">View submission details <span aria-hidden="true">→</span></a>
  </aside>

  <section class="hero">
    <div class="hero-grid">
      <div>
        <h1>Insect-scale Autonomy Workshop</h1>
        <p>What principles, algorithms, and system designs enable reliable autonomy when resources are tightly constrained?</p>
        <div class="badges">
          <span class="badge">Full-day</span>
          <span class="badge">Invited talks + posters/demos + panel</span>
          <span class="badge">Best Poster/Demo Award</span>
        </div>
      </div>
      <div class="card">
        <h3>Quick info</h3>
        <p><strong>Focus:</strong> Bio-inspired, resource-constrained Autonomy across perception, design, control, and edge AI.</p>
        <p><strong>Venue:</strong> IROS 2026 (Pittsburgh)</p>
        <p><strong>Date:</strong> Oct 1, 2026 (Full Day Workshop)</p>
        <p><strong>Time:</strong> 8:30 AM — 5.30 PM</p>
        <p><strong>Submission deadline:</strong> Sep 1, 2026, 11:59 PM AoE</p>
        <a
          class="openreview-button"
          href="https://openreview.net/group?id=IEEE.org/IROS/2026/Workshop/Insect-Scale_Autonomy"
          target="_blank"
          rel="noopener noreferrer"
        >
          Submit on OpenReview
          <span aria-hidden="true">→</span>
        </a>

      </div>
    </div>
  </section>
  <section class="section">
    <div class="prose">
      <Content />
    </div>
  </section>
  <section class="sponsors-section" aria-labelledby="sponsors-heading">
    <p class="sponsors-label">Workshop Sponsor</p>
    <h2 id="sponsors-heading">Sponsors</h2>
    <a
      class="sponsor-card"
      href="https://centeye.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit Centeye"
    >
      <img src="/sponsors/centeye.svg" alt="Centeye" width="260" height="105" />
      <span>Advanced Vision Technology</span>
    </a>
    <p class="sponsor-contact">Interested in sponsoring the workshop? Contact <a href="mailto:chahat.singh@colorado.edu">chahat.singh@colorado.edu</a>.</p>
  </section>
</PageLayout>

<style is:global>
  .deadline-notice{
    display: flex;
    gap: 14px 22px;
    align-items: center;
    margin: 22px 0 0;
    padding: 14px 18px;
    border: 1px solid color-mix(in srgb, #d99a00 52%, var(--line));
    border-radius: 12px;
    background: color-mix(in srgb, #f4bd32 18%, var(--panel));
    color: var(--text);
  }

  .deadline-notice strong{
    color: #a86e00;
    font-size: 15px;
    white-space: nowrap;
  }

  :root[data-theme="dark"] .deadline-notice strong{
    color: #fff1bd;
  }

  .deadline-notice > span{
    flex: 1;
    font-size: 14px;
    line-height: 1.45;
  }

  .deadline-notice a{
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .sponsors-section{
    margin: 14px 0 12px;
    text-align: center;
  }

  .sponsors-label{
    margin: 0 0 2px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .sponsors-section h2{
    margin: 0 0 12px;
    font-size: 24px;
  }

  .sponsor-card{
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 220px;
    padding: 14px 24px 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fffdf8;
    box-shadow: 0 8px 22px rgba(0,0,0,.08);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .sponsor-card:hover{
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--link) 32%, var(--line));
    box-shadow: 0 12px 28px rgba(0,0,0,.12);
    text-decoration: none;
  }

  .sponsor-card img{
    display: block;
    width: min(220px, 100%);
    height: auto;
  }

  .sponsor-card span{
    color: #3e52a4;
    font-size: 12px;
    font-weight: 700;
  }

  .sponsor-contact{
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .focus-grid{
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 18px 0 28px;
  }

  .focus-card{
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      box-shadow 170ms ease,
      background-color 170ms ease;
  }

  .focus-card:hover{
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--link) 32%, var(--line));
    background: color-mix(in srgb, var(--link) 5%, var(--panel));
    box-shadow: 0 10px 24px rgba(0,0,0,.08);
  }

  .prose .focus-card img{
    width: min(100%, 280px);
    height: auto;
    margin: 0 auto 14px;
    border-radius: 12px;
    box-shadow: none;
  }

  .prose .focus-card img:hover{
    transform: none;
    box-shadow: none;
  }

  .focus-card h3{
    margin: 0 0 10px;
    color: var(--text);
    font-size: 18px;
    line-height: 1.35;
  }

  .focus-card > p{
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .focus-question{
    margin-top: auto;
    padding: 13px 14px 14px;
    border-left: 3px solid color-mix(in srgb, var(--link) 72%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--link) 8%, var(--panel));
  }

  .focus-question span{
    display: block;
    margin-bottom: 7px;
    color: var(--link);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .065em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .focus-question p{
    margin: 0;
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.5;
  }

  @media (max-width: 900px){
    .focus-grid{
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .focus-card:last-child{
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px){
    .deadline-notice{
      display: block;
      text-align: center;
    }

    .deadline-notice strong,
    .deadline-notice > span,
    .deadline-notice a{
      display: block;
    }

    .deadline-notice > span{
      margin: 5px 0 8px;
    }

    .hero-grid > .card{
      text-align: center;
    }

    .sponsor-card{
      min-width: 0;
      padding: 12px 20px 10px;
    }

    .focus-grid{
      grid-template-columns: 1fr;
    }

    .focus-card:last-child{
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .focus-card{
      transition: none;
    }

    .focus-card:hover{
      transform: none;
    }
  }
</style>
