---
import PageLayout from "../layouts/PageLayout.astro";
import { getEntryBySlug } from "astro:content";

const entry = await getEntryBySlug("pages", "home");
if (!entry) throw new Error("Missing content: src/content/pages/home.md");

const { Content } = await entry.render();
const data = entry.data;
---

<PageLayout title={data.title} description={data.description}>

  <aside class="deadline-notice" aria-label="Submission deadline extension">
    <strong>Submission deadline extended</strong>
    <span>Paper and poster submissions are now due September 15, 2026, at 11:59 PM AoE.</span>
    <a href="/cfp/">View submission details <span aria-hidden="true">→</span></a>
  </aside>

  <section class="hero">
    <div class="hero-grid">
      <div>
        <h1>Insect-scale Autonomy Workshop</h1>
        <p>What principles, algorithms, and system designs enable reliable autonomy when resources are tightly constrained?</p>
        <div class="badges">
          <span class="badge">Full-day</span>
          <span class="badge">Invited talks + posters/demos + panel</span>
          <span class="badge">Best Poster/Demo Award</span>
        </div>
      </div>
      <div class="card">
        <h3>Quick info</h3>
        <p><strong>Focus:</strong> Bio-inspired, resource-constrained Autonomy across perception, design, control, and edge AI.</p>
        <p><strong>Venue:</strong> IROS 2026 (Pittsburgh)</p>
        <p><strong>Date:</strong> Oct 1, 2026 (Full Day Workshop)</p>
        <p><strong>Time:</strong> 8:30 AM — 5.30 PM</p>
        <p><strong>Submission deadline:</strong> Sep 15, 2026, 11:59 PM AoE</p>
        <a
          class="openreview-button"
          href="https://openreview.net/group?id=IEEE.org/IROS/2026/Workshop/Insect-Scale_Autonomy"
          target="_blank"
          rel="noopener noreferrer"
        >
          Submit on OpenReview
          <span aria-hidden="true">→</span>
        </a>

      </div>
    </div>
  </section>
  <section class="section">
    <div class="prose">
      <Content />
    </div>
  </section>
  <section class="sponsors-section" aria-labelledby="sponsors-heading">
    <p class="sponsors-label">Workshop Sponsor</p>
    <h2 id="sponsors-heading">Sponsors</h2>
    <div class="sponsor-list">
      <a
        class="sponsor-card"
        href="https://centeye.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit Centeye"
      >
        <img src="/sponsors/centeye.svg" alt="Centeye" width="260" height="105" />
        <span>Advanced Vision Technology</span>
      </a>
      <a
        class="sponsor-card"
        href="https://www.synsense.ai/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit SynSense"
      >
        <img src="/sponsors/synsense.svg" alt="SynSense" width="260" height="105" />
        <span>Neuromorphic Intelligence</span>
      </a>
      <a
        class="sponsor-card sponsor-card--inivation"
        href="https://inivation.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit iniVation"
      >
        <img src="/sponsors/inivation.png" alt="iniVation" width="260" height="105" />
        <span>Event-Based Vision Systems</span>
      </a>
    </div>
    <p class="sponsor-contact">Interested in sponsoring the workshop? Contact <a href="mailto:chahat.singh@colorado.edu">chahat.singh@colorado.edu</a>.</p>

    <div class="institution-affiliations" aria-labelledby="institutions-heading">
      <p class="institution-label" id="institutions-heading">Organized by researchers from</p>
      <div class="institution-list">
        <a href="https://www.colorado.edu/" target="_blank" rel="noopener noreferrer" aria-label="University of Colorado Boulder">
          <img src="/institutions/cu-boulder-centered.png" alt="University of Colorado Boulder" width="1247" height="709" />
        </a>
        <a href="https://www.imperial.ac.uk/" target="_blank" rel="noopener noreferrer" aria-label="Imperial College London">
          <img src="/institutions/imperial.png" alt="Imperial College London" width="12900" height="1417" />
        </a>
        <a href="https://www.tudelft.nl/en/" target="_blank" rel="noopener noreferrer" aria-label="TU Delft">
          <img src="/institutions/tu-delft.svg" alt="TU Delft" />
        </a>
        <a href="https://www.umd.edu/" target="_blank" rel="noopener noreferrer" aria-label="University of Maryland">
          <img src="/institutions/maryland-primary.jpg" alt="University of Maryland" width="1801" height="601" />
        </a>
      </div>
      <a class="organizers-link" href="/organizers/">Meet the organizers <span aria-hidden="true">→</span></a>

      <div class="speaker-affiliations" aria-labelledby="speaker-affiliations-heading">
        <p class="speaker-affiliations-label" id="speaker-affiliations-heading">Featuring speakers from</p>
        <div class="speaker-affiliation-list">
          <a href="https://www.harvard.edu/" target="_blank" rel="noopener noreferrer" aria-label="Harvard University" title="Harvard University">
            <span class="speaker-logo-frame"><img class="speaker-logo speaker-logo--seal" src="/institutions/speakers/harvard.png" alt="" width="512" height="512" /></span>
            <span class="speaker-affiliation-name">Harvard</span>
          </a>
          <a href="https://www.sandia.gov/" target="_blank" rel="noopener noreferrer" aria-label="Sandia National Laboratories" title="Sandia National Laboratories">
            <span class="speaker-logo-frame"><img src="/institutions/speakers/sandia.svg" alt="" /></span>
            <span class="speaker-affiliation-name">Sandia National Labs</span>
          </a>
          <a href="https://www.cmu.edu/" target="_blank" rel="noopener noreferrer" aria-label="Carnegie Mellon University" title="Carnegie Mellon University">
            <span class="speaker-logo-frame"><img class="speaker-logo speaker-logo--square" src="/institutions/speakers/cmu.png" alt="" width="900" height="900" /></span>
            <span class="speaker-affiliation-name">Carnegie Mellon</span>
          </a>
          <a href="https://www.washington.edu/" target="_blank" rel="noopener noreferrer" aria-label="University of Washington" title="University of Washington">
            <span class="speaker-logo-frame"><img class="speaker-logo speaker-logo--wide" src="/institutions/speakers/washington.png" alt="" width="1056" height="216" /></span>
            <span class="speaker-affiliation-name">University of Washington</span>
          </a>
          <a href="https://idsia.ch/" target="_blank" rel="noopener noreferrer" aria-label="Dalle Molle Institute for Artificial Intelligence" title="Dalle Molle Institute for Artificial Intelligence">
            <span class="speaker-logo-frame"><img class="speaker-logo speaker-logo--seal" src="/institutions/speakers/idsia.png" alt="" width="460" height="460" /></span>
            <span class="speaker-affiliation-name">Dalle Molle Institute</span>
          </a>
          <a class="speaker-affiliation--paired" href="https://www.univ-amu.fr/" target="_blank" rel="noopener noreferrer" aria-label="Aix-Marseille University and CNRS" title="Aix-Marseille University and CNRS">
            <span class="speaker-logo-frame speaker-logo-frame--paired">
              <img src="/institutions/speakers/amu.svg" alt="" />
              <img src="/institutions/speakers/cnrs.svg" alt="" />
            </span>
            <span class="speaker-affiliation-name">Aix-Marseille / CNRS</span>
          </a>
        </div>
        <a class="speakers-link" href="/speakers/">View all speakers <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  .deadline-notice{
    display: flex;
    gap: 14px 22px;
    align-items: center;
    margin: 22px 0 0;
    padding: 14px 18px;
    border: 1px solid color-mix(in srgb, #d99a00 52%, var(--line));
    border-radius: 12px;
    background: color-mix(in srgb, #f4bd32 18%, var(--panel));
    color: var(--text);
  }

  .deadline-notice strong{
    color: #a86e00;
    font-size: 15px;
    white-space: nowrap;
  }

  :root[data-theme="dark"] .deadline-notice strong{
    color: #fff1bd;
  }

  .deadline-notice > span{
    flex: 1;
    font-size: 14px;
    line-height: 1.45;
  }

  .deadline-notice a{
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .sponsors-section{
    margin: 14px 0 12px;
    text-align: center;
  }

  .sponsors-label{
    margin: 0 0 2px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .sponsors-section h2{
    margin: 0 0 12px;
    font-size: 24px;
  }

  .sponsor-list{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .sponsor-card{
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 220px;
    padding: 14px 24px 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fffdf8;
    box-shadow: 0 8px 22px rgba(0,0,0,.08);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .sponsor-card:hover{
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--link) 32%, var(--line));
    box-shadow: 0 12px 28px rgba(0,0,0,.12);
    text-decoration: none;
  }

  .sponsor-card img{
    display: block;
    width: min(220px, 100%);
    height: 74px;
    object-fit: contain;
  }

  .sponsor-card span{
    color: #3e52a4;
    font-size: 12px;
    font-weight: 700;
  }

  .sponsor-card--inivation img{
    transform: scale(1.2);
  }

  .sponsor-contact{
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .institution-affiliations{
    margin: 30px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .institution-label{
    margin: 0 0 14px;
    color: var(--text);
    font-size: 16px;
    font-weight: 700;
  }

  .institution-list{
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 12px;
    max-width: 880px;
    margin: 0 auto;
  }

  .institution-list a{
    min-width: 0;
    min-height: 108px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 15px;
    border: 1px solid color-mix(in srgb, var(--muted) 22%, var(--line));
    border-radius: 12px;
    background: #fff;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .institution-list a:hover{
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    transform: translateY(-1px);
  }

  .institution-list img{
    display: block;
    width: 100%;
    max-width: 150px;
    height: 44px;
    object-fit: contain;
  }

  .institution-list a:nth-child(1) img{
    max-width: 160px;
    height: 90px;
  }

  .institution-list a:nth-child(2) img{
    max-width: 145px;
    height: 38px;
  }

  .institution-list a:nth-child(3) img{
    max-width: 125px;
    height: 48px;
    position: relative;
    top: -4px;
  }

  .institution-list a:nth-child(4) img{
    max-width: 175px;
    height: 50px;
  }

  .organizers-link{
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
  }

  .speaker-affiliations{
    max-width: 940px;
    margin: 24px auto 0;
    padding-top: 21px;
    border-top: 1px solid var(--line);
  }

  .speaker-affiliations-label{
    margin: 0 0 12px;
    color: var(--text);
    font-size: 15px;
    font-weight: 700;
  }

  .speaker-affiliation-list{
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .speaker-affiliation-list a{
    min-width: 0;
    min-height: 82px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 8px 10px 7px;
    border: 1px solid color-mix(in srgb, var(--muted) 22%, var(--line));
    border-radius: 10px;
    background: #fff;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .speaker-affiliation-list a:hover{
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    transform: translateY(-1px);
  }

  .speaker-affiliation-list img{
    display: block;
    width: auto;
    max-width: 108px;
    height: auto;
    max-height: 36px;
    object-fit: contain;
  }

  .speaker-logo-frame{
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .speaker-affiliation-name{
    color: #4f4b44;
    font-size: 10.5px;
    font-weight: 650;
    line-height: 1.15;
    text-align: center;
  }

  .speaker-affiliation-list .speaker-logo--seal,
  .speaker-affiliation-list .speaker-logo--square{
    max-width: 40px;
    max-height: 40px;
  }

  .speaker-affiliation-list .speaker-logo--wide{
    max-width: 116px;
    max-height: 32px;
  }

  .speaker-affiliation-list .speaker-logo-frame--paired{
    gap: 8px;
  }

  .speaker-affiliation-list .speaker-logo-frame--paired img:first-child{
    max-width: 74px;
    max-height: 34px;
  }

  .speaker-affiliation-list .speaker-logo-frame--paired img:last-child{
    max-width: 30px;
    max-height: 30px;
  }

  .speakers-link{
    display: inline-block;
    margin-top: 11px;
    font-size: 13px;
    font-weight: 700;
  }

  .focus-grid{
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 18px 0 28px;
  }

  .focus-card{
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      box-shadow 170ms ease,
      background-color 170ms ease;
  }

  .focus-card:hover{
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--link) 32%, var(--line));
    background: color-mix(in srgb, var(--link) 5%, var(--panel));
    box-shadow: 0 10px 24px rgba(0,0,0,.08);
  }

  .prose .focus-card img{
    width: min(100%, 280px);
    height: auto;
    margin: 0 auto 14px;
    border-radius: 12px;
    box-shadow: none;
  }

  .prose .focus-card img:hover{
    transform: none;
    box-shadow: none;
  }

  .focus-card h3{
    margin: 0 0 10px;
    color: var(--text);
    font-size: 18px;
    line-height: 1.35;
  }

  .focus-card > p{
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .focus-question{
    margin-top: auto;
    padding: 13px 14px 14px;
    border-left: 3px solid color-mix(in srgb, var(--link) 72%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--link) 8%, var(--panel));
  }

  .focus-question span{
    display: block;
    margin-bottom: 7px;
    color: var(--link);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .065em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .focus-question p{
    margin: 0;
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.5;
  }

  @media (max-width: 900px){
    .speaker-affiliation-list{
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .focus-grid{
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .focus-card:last-child{
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px){
    .deadline-notice{
      display: block;
      text-align: center;
    }

    .deadline-notice strong,
    .deadline-notice > span,
    .deadline-notice a{
      display: block;
    }

    .deadline-notice > span{
      margin: 5px 0 8px;
    }

    .hero-grid > .card{
      text-align: center;
    }

    .sponsor-card{
      min-width: 0;
      padding: 12px 20px 10px;
    }

    .institution-list{
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .institution-list a{
      min-height: 96px;
      padding: 10px 12px;
    }

    .institution-list img,
    .institution-list a:nth-child(2) img{
      max-width: 135px;
      height: 40px;
    }

    .institution-list a:nth-child(1) img{
      max-width: 145px;
      height: 82px;
    }

    .institution-list a:nth-child(3) img{
      max-width: 112px;
      height: 43px;
      top: -3px;
    }

    .institution-list a:nth-child(4) img{
      max-width: 150px;
      height: 43px;
    }

    .speaker-affiliation-list{
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .focus-grid{
      grid-template-columns: 1fr;
    }

    .focus-card:last-child{
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .focus-card{
      transition: none;
    }

    .focus-card:hover{
      transform: none;
    }
  }
</style>
