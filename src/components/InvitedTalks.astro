---
const { people = [] } = Astro.props;

const talks = people.filter(
  (person) => person.talkTitle && (person.abstract || person.bio),
);
const talkId = (name) =>
  `talk-${name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;
const roleClass = (status) =>
  status ? `role-${status.toLowerCase().replace(/\s+/g, "-")}` : "";
---

{talks.length > 0 && (
  <section class="talks" aria-labelledby="invited-talks-heading">
    <header class="talks-heading">
      <h2 id="invited-talks-heading">Invited Talks</h2>
      <p>Talk abstracts and speaker biographies are added as they are confirmed.</p>
    </header>

    <div class="talk-list">
      {talks.map((person) => (
        <article id={talkId(person.name)} class={`talk-card ${roleClass(person.status)}`}>
          <div class="speaker-panel">
            {person.photo ? (
              <img
                src={person.photo}
                alt={person.name}
                loading="lazy"
                width="128"
                height="128"
              />
            ) : (
              <div class="speaker-photo-placeholder" aria-label={person.name}>
                {person.name.split(" ").map((part) => part[0]).join("")}
              </div>
            )}
            <div>
              <p class="label">Speaker</p>
              <h3>{person.name}</h3>
              <p class="affiliation">{person.affiliation}</p>
            </div>
          </div>

          <div class="talk-body">
            <p class="label role-label">{person.status || "Invited Talk"}</p>
            <h3 class="talk-title">{person.talkTitle}</h3>

            {person.abstract && (
              <section class="copy-block" aria-labelledby={`${talkId(person.name)}-abstract`}>
                <h4 id={`${talkId(person.name)}-abstract`}>Abstract</h4>
                <p>{person.abstract}</p>
              </section>
            )}

            {person.abstractCredit && (
              <p class="abstract-credit"><em>{person.abstractCredit}</em></p>
            )}

            {person.bio && (
              <section class="copy-block" aria-labelledby={`${talkId(person.name)}-bio`}>
                <h4 id={`${talkId(person.name)}-bio`}>Speaker Bio</h4>
                <p>{person.bio}</p>
              </section>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .talks {
    margin-top: 42px;
  }

  .talks-heading {
    margin-bottom: 18px;
    text-align: center;
  }

  .talks-heading h2 {
    margin: 0 0 4px;
  }

  .talks-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .talk-list {
    display: grid;
    gap: 20px;
  }

  .talk-card {
    --talk-accent: #a34858;
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 30px;
    padding: 26px;
    scroll-margin-top: 110px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--panel2);
    overflow: hidden;
  }

  .talk-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--talk-accent) 70%, transparent);
  }

  .talk-card.role-industry-talk {
    --talk-accent: #4e5964;
  }

  .talk-card.role-rising-star-talk {
    --talk-accent: #6d4c7d;
  }

  .speaker-panel {
    align-self: start;
  }

  .speaker-panel img,
  .speaker-photo-placeholder {
    display: block;
    width: 128px;
    height: 128px;
    margin: 4px 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    object-fit: cover;
  }

  .speaker-photo-placeholder {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--talk-accent) 12%, var(--panel));
    color: var(--talk-accent);
    font-size: 30px;
    font-weight: 750;
    letter-spacing: .03em;
  }

  .label {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .role-label {
    color: var(--talk-accent);
  }

  :global(:root[data-theme="dark"]) .talk-card {
    --talk-accent: #e3a0ab;
  }

  :global(:root[data-theme="dark"]) .talk-card.role-industry-talk {
    --talk-accent: #bac5cf;
  }

  :global(:root[data-theme="dark"]) .talk-card.role-rising-star-talk {
    --talk-accent: #c8a7d8;
  }

  .speaker-panel h3 {
    margin: 0 0 5px;
    font-size: 20px;
    line-height: 1.25;
  }

  .affiliation {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .talk-body {
    min-width: 0;
  }

  .talk-title {
    max-width: 760px;
    margin: 0 0 22px;
    font-size: clamp(23px, 3vw, 32px);
    line-height: 1.2;
    letter-spacing: -.015em;
  }

  .copy-block + .copy-block {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .copy-block h4 {
    margin: 0 0 8px;
    font-size: 15px;
  }

  .copy-block p {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
    text-align: justify;
    text-justify: inter-word;
  }

  .abstract-credit {
    margin: 18px 0 0;
    color: var(--muted);
    line-height: 1.72;
  }

  .abstract-credit + .copy-block {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .talks {
      margin-top: 34px;
    }

    .talk-card {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 22px;
    }

    .speaker-panel {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 16px;
      align-items: center;
    }

    .speaker-panel img,
    .speaker-photo-placeholder {
      width: 88px;
      height: 88px;
      margin: 0;
    }

    .talk-title {
      margin-bottom: 18px;
    }
  }
</style>
