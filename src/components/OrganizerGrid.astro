---
const { people = [] } = Astro.props;
---

<div class="organizer-grid">
  {people.map((person) => (
    <article class="organizer-card">
      <a
        class="organizer-photo-link"
        href={person.website}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visit ${person.name}'s website`}
      >
        <img
          class="organizer-photo"
          src={`/organizers/${person.photo}`}
          alt={`Portrait of ${person.name}`}
          loading="lazy"
          width="320"
          height="320"
        />
      </a>

      <div class="organizer-content">
        <h2>{person.name}</h2>
        <p class="organizer-affiliation">{person.affiliation}</p>

        {person.website && (
          <a
            class="organizer-link"
            href={person.website}
            target="_blank"
            rel="noopener noreferrer"
          >
            {person.lab || "Website"} →
          </a>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .organizer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .organizer-card {
    overflow: hidden;
    background: var(--panel2);
    border: 1px solid var(--line);
    border-radius: 18px;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .organizer-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--link) 35%, var(--line));
    box-shadow: 0 14px 30px rgba(11, 18, 32, 0.08);
  }

  .organizer-photo-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }

  .organizer-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 220ms ease;
  }

  .organizer-card:hover .organizer-photo {
    transform: scale(1.025);
  }

  .organizer-content {
    padding: 16px 16px 18px;
    display: flex;
    flex-direction: column;
    min-height: 128px;
  }

  .organizer-content h2 {
    margin: 0 0 5px;
    color: var(--text);
    font-size: 19px;
    line-height: 1.25;
  }

  .organizer-affiliation {
    min-height: 42px;
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .organizer-link {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 650;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .organizer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .organizer-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .organizer-card {
      display: grid;
      grid-template-columns: 116px minmax(0, 1fr);
      align-items: stretch;
    }

    .organizer-photo-link {
      aspect-ratio: auto;
      height: 100%;
      min-height: 150px;
    }

    .organizer-content {
      padding: 16px;
    }

    .organizer-affiliation {
      min-height: 0;
    }
  }
</style>
