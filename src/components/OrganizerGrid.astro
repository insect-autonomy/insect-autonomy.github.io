---
const { people = [] } = Astro.props;
---

<div class="organizer-grid">
  {people.map((person) => {
    const hasLinks =
      person.website ||
      person.labWebsite ||
      person.scholar ||
      person.linkedin ||
      person.github;

    return (
      <article class="organizer-card">
        <div class="organizer-profile">
          <img
            class="organizer-photo"
            src={`/organizers/${person.photo}`}
            alt={`Portrait of ${person.name}`}
            loading="lazy"
            width="112"
            height="112"
          />

          <div class="organizer-identity">
            <h2>{person.name}</h2>
            <p class="organizer-affiliation">{person.affiliation}</p>
          </div>
        </div>

        {person.lab && (
          <p class="organizer-lab">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 3h6"></path>
              <path d="M10 3v5l-5 9a2.7 2.7 0 0 0 2.4 4h9.2a2.7 2.7 0 0 0 2.4-4l-5-9V3"></path>
              <path d="M7.5 15h9"></path>
            </svg>
            <span>{person.lab}</span>
          </p>
        )}

        {hasLinks && (
          <div class="organizer-actions" aria-label={`${person.name} links`}>
            {person.website && (
              <a
                class="icon-link"
                href={person.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} website`}
                title="Personal or institutional profile"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M3 12h18"></path>
                  <path d="M12 3a15 15 0 0 1 0 18"></path>
                  <path d="M12 3a15 15 0 0 0 0 18"></path>
                </svg>
              </a>
            )}

            {person.labWebsite && (
              <a
                class="icon-link"
                href={person.labWebsite}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} laboratory`}
                title="Laboratory"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 3h6"></path>
                  <path d="M10 3v5l-5 9a2.7 2.7 0 0 0 2.4 4h9.2a2.7 2.7 0 0 0 2.4-4l-5-9V3"></path>
                  <path d="M7.5 15h9"></path>
                </svg>
              </a>
            )}

            {person.scholar && (
              <a
                class="icon-link"
                href={person.scholar}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} Google Scholar`}
                title="Google Scholar"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 9.5 12 4l9 5.5-9 5.5-9-5.5Z"></path>
                  <path d="M7 12.5V17c2.8 2 7.2 2 10 0v-4.5"></path>
                </svg>
              </a>
            )}

            {person.linkedin && (
              <a
                class="icon-link linkedin-link"
                href={person.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} LinkedIn`}
                title="LinkedIn"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.5 8.5H3.5V20H6.5V8.5Z"></path>
                  <path d="M5 3.7a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6Z"></path>
                  <path d="M10 8.5h3v1.6c.9-1.2 2.2-2 4-2 3.1 0 4.5 2 4.5 5.5V20h-3v-5.8c0-2-.7-3.2-2.4-3.2-1.9 0-3.1 1.3-3.1 3.7V20h-3V8.5Z"></path>
                </svg>
              </a>
            )}

            {person.github && (
              <a
                class="icon-link github-link"
                href={person.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} GitHub`}
                title="GitHub"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5.1 0-1.1.4-2.1 1-2.8-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.9 1.1a9.8 9.8 0 0 1 5.2 0C17.2 4.7 18 5 18 5c.5 1.4.2 2.4.1 2.7.7.7 1 1.7 1 2.8 0 4-2.4 4.8-4.7 5.1.4.3.7 1 .7 1.9v2.7c0 .3.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z"></path>
                </svg>
              </a>
            )}
          </div>
        )}
      </article>
    );
  })}
</div>

<style>
  .organizer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 22px;
  }

  .organizer-card {
    display: flex;
    min-height: 225px;
    flex-direction: column;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--panel2) 92%, transparent),
        color-mix(in srgb, var(--panel) 82%, transparent)
      );
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .organizer-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--link) 36%, var(--line));
    box-shadow: 0 14px 32px rgba(11, 18, 32, 0.1);
  }

  .organizer-profile {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 15px;
    align-items: center;
  }

  .organizer-photo {
    display: block;
    width: 96px;
    height: 96px;
    border: 1px solid var(--line);
    border-radius: 999px;
    object-fit: cover;
    object-position: center top;
    background: var(--panel);
  }

  .organizer-identity {
    min-width: 0;
  }

  .organizer-identity h2 {
    margin: 0 0 6px;
    color: var(--text);
    font-size: 19px;
    line-height: 1.2;
  }

  .organizer-affiliation {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .organizer-lab {
    display: grid;
    grid-template-columns: 17px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    margin: 15px 0 0;
    padding-top: 13px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .organizer-lab svg {
    width: 16px;
    height: 16px;
    margin-top: 1px;
    fill: none;
    stroke: var(--link);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .organizer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 15px;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 88%, var(--text) 12%);
    color: var(--muted);
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }

  .icon-link:hover {
    color: var(--link);
    border-color: color-mix(in srgb, var(--link) 55%, var(--line));
    background: color-mix(in srgb, var(--link) 10%, transparent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .icon-link svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .linkedin-link svg,
  .github-link svg {
    fill: currentColor;
    stroke: none;
  }

  @media (max-width: 940px) {
    .organizer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .organizer-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .organizer-card {
      min-height: 0;
      padding: 16px;
    }

    .organizer-profile {
      grid-template-columns: 82px minmax(0, 1fr);
    }

    .organizer-photo {
      width: 82px;
      height: 82px;
    }
  }
</style>
