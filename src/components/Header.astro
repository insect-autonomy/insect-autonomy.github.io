---
const nav = [
  { href: "/", label: "Home" },
  { href: "/cfp", label: "Call for Papers" },
  { href: "/program", label: "Program" },
  { href: "/speakers", label: "Speakers" },
  { href: "/organizers", label: "Organizers" }
];

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="header">
  <div class="container navbar">
    <div class="brand">
      <a href="/">Insect-scale Autonomy</a>
      <small>IROS 2026 Workshop · Pittsburgh · Oct 1, 2026</small>
    </div>

    <nav class="nav" aria-label="Primary navigation">
      {nav.map((x) => (
        <a
          href={x.href}
          class:list={{ active: isActive(x.href) }}
          aria-current={isActive(x.href) ? "page" : undefined}
        >
          {x.label}
        </a>
      ))}
    </nav>

    <button
      id="themeToggle"
      class="themeBtn"
      type="button"
      aria-label="Toggle theme"
    >
      <span id="themeIcon" aria-hidden="true">☀</span>
    </button>

    <script>
      const root = document.documentElement;
      const icon = document.getElementById("themeIcon");
      const btn = document.getElementById("themeToggle");

      const apply = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        icon.textContent = theme === "light" ? "☾" : "☀";
      };

      const saved = localStorage.getItem("theme");
      const systemLight =
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: light)").matches;

      apply(saved ?? (systemLight ? "light" : "dark"));

      btn?.addEventListener("click", () => {
        apply(root.dataset.theme === "light" ? "dark" : "light");
      });
    </script>
  </div>
</header>
