---
const nav = [
  { href: "/", label: "Home" },
  { href: "/cfp", label: "Call for Papers" },
  { href: "/program", label: "Program" },
  { href: "/speakers", label: "Speakers" },
  { href: "/organizers", label: "Organizers" }
];

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="header">
  <div class="container navbar">
    <div class="brand">
      <img class="brandIcon" src="/BeeLogoHeader.png" alt="" width="38" height="38" />
      <div class="brandCopy">
        <a href="/">Insect-scale Autonomy</a>
        <small>IROS 2026 Workshop · Pittsburgh · Oct 1, 2026</small>
      </div>
    </div>

    <nav class="nav" aria-label="Primary navigation">
      {nav.map((x) => (
        <a
          href={x.href}
          class:list={{ active: isActive(x.href) }}
          aria-current={isActive(x.href) ? "page" : undefined}
        >
          <span class="navIcon" aria-hidden="true">
            {x.href === "/" && (
              <svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z"></path></svg>
            )}
            {x.href === "/cfp" && (
              <svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6V3Z"></path><path d="M14 3v5h5M9 12h6M9 16h6"></path></svg>
            )}
            {x.href === "/program" && (
              <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18M8 14h3M13 14h3M8 17h3"></path></svg>
            )}
            {x.href === "/speakers" && (
              <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"></path></svg>
            )}
            {x.href === "/organizers" && (
              <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.5"></circle><path d="M3 20c0-4 2.5-6 6-6s6 2 6 6M14 15c3.6-.8 7 1 7 5"></path></svg>
            )}
          </span>
          <span class="navLabel">
            {x.href === "/cfp" ? (
              <><span class="navLabelDesktop">Call for Papers</span><span class="navLabelMobile">CFP</span></>
            ) : x.label}
          </span>
        </a>
      ))}
    </nav>

    <button
      id="themeToggle"
      class="themeBtn"
      type="button"
      aria-label="Switch to light mode"
      aria-pressed="true"
      title="Switch color theme"
    >
      <span class="themeTrack" aria-hidden="true">
        <svg class="themeIcon themeIconSun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </svg>
        <svg class="themeIcon themeIconMoon" viewBox="0 0 24 24">
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"></path>
        </svg>
        <span class="themeThumb"></span>
      </span>
    </button>

    <script>
      const root = document.documentElement;
      const btn = document.getElementById("themeToggle");

      const apply = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        const isDark = theme === "dark";
        btn?.setAttribute("aria-pressed", String(isDark));
        btn?.setAttribute(
          "aria-label",
          isDark ? "Switch to light mode" : "Switch to dark mode"
        );
      };

      const saved = localStorage.getItem("theme");
      const phoneViewport = window.matchMedia("(max-width: 700px)").matches;

      apply(saved ?? (phoneViewport ? "dark" : "light"));

      btn?.addEventListener("click", () => {
        apply(root.dataset.theme === "light" ? "dark" : "light");
      });
    </script>
  </div>
</header>
