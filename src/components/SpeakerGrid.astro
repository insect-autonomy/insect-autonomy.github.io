---
const { title, people = [] } = Astro.props;

const talkId = (name) =>
  `talk-${name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;
---

<section class="speaker-section">
  <h2>{title}</h2>

  <div class="grid">
    {people.map((person) => (
      <article class="speaker-card">
        <img
          class="avatar"
          src={person.photo}
          alt={person.name}
          loading="lazy"
          width="120"
          height="120"
        />
        <div class="name">{person.name}</div>
        <div class="role">{person.affiliation}</div>
        {person.status && <div class="meta">{person.status}</div>}

        {person.talkTitle && (
          <a
            class="talk-link"
            href={`#${talkId(person.name)}`}
            aria-label={`View talk details for ${person.name}`}
          >
            Talk details <span aria-hidden="true">↓</span>
          </a>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .speaker-section {
    margin-top: 18px;
  }

  .speaker-section h2 {
    margin: 0 0 12px;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .speaker-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel2);
    text-align: center;
  }

  .avatar {
    display: block;
    width: 120px;
    height: 120px;
    margin: 8px auto 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    object-fit: cover;
  }

  .name {
    margin: 0 0 6px;
    color: var(--text);
    font-size: 18px;
    font-weight: 750;
  }

  .role {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .meta {
    color: var(--muted);
    font-size: 12px;
    font-style: italic;
  }

  .talk-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: auto;
    padding: 7px 12px;
    border: 1px solid color-mix(in srgb, var(--link) 50%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--link) 9%, transparent);
    color: var(--text);
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
  }

  .talk-link:hover {
    background: color-mix(in srgb, var(--link) 16%, transparent);
    text-decoration: none;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
